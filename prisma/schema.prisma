// FinTrack — Personal Finance OS
// Money is stored as integer paise (BigInt) and converted to a plain `number`
// at the data-layer boundary so nothing leaks BigInt into client components.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  // Indian mobile number, stored as 10 digits — the login identifier.
  phone            String   @unique
  passwordHash     String
  email            String?  @unique
  name             String
  currency         String   @default("INR")
  // Salary Intelligence: expected monthly take-home, used to seed allocations.
  monthlyIncome    BigInt   @default(0)
  // Safe-to-Spend: portion of income the user always wants to protect.
  savingsTargetPct Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  goals          Goal[]
  sessions       Session[]
  parties        Party[]
  khataEntries   KhataEntry[]
  groupsCreated  Group[]
  groupMembers   GroupMember[]
}

// Splitwise-style shared expenses. Members are existing FinTrack users added
// directly (WhatsApp-style) by mobile number or contact search.
model Group {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    GroupExpense[]
  settlements GroupSettlement[]
}

model GroupMember {
  id              String    @id @default(cuid())
  groupId         String
  // Null only for legacy email invites that were never accepted.
  userId          String?
  name            String
  // Only set on legacy email invites.
  email           String?
  // OWNER | MEMBER
  role            String    @default("MEMBER")
  // SHA-256 of the one-time invite token; cleared once accepted.
  inviteTokenHash String?   @unique
  joinedAt        DateTime?
  // Set when they leave; the row stays so past expenses and a later re-add keep their history.
  leftAt          DateTime?
  createdAt       DateTime  @default(now())

  group    Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  paid     GroupExpense[]      @relation("ExpensePaidBy")
  shares   GroupExpenseShare[]
  sent     GroupSettlement[]   @relation("SettlementFrom")
  received GroupSettlement[]   @relation("SettlementTo")

  @@unique([groupId, email])
  @@unique([groupId, userId])
  @@index([userId])
}

model GroupExpense {
  id          String   @id @default(cuid())
  groupId     String
  description String
  amount      BigInt
  paidById    String
  // EQUAL | EXACT | PERCENT
  splitType   String   @default("EQUAL")
  date        DateTime
  createdById String
  createdAt   DateTime @default(now())

  group  Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy GroupMember         @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  shares GroupExpenseShare[]

  @@index([groupId, date])
}

model GroupExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  memberId  String
  amount    BigInt

  expense GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model GroupSettlement {
  id           String   @id @default(cuid())
  groupId      String
  fromMemberId String
  toMemberId   String
  amount       BigInt
  date         DateTime
  createdById  String
  createdAt    DateTime @default(now())

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  GroupMember @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  to    GroupMember @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@index([groupId, date])
}

// Khata (udhaar) ledger: people and businesses you owe, or who owe you.
// Deliberately separate from the cash ledger — these are receivables and
// payables, not money that has moved in or out of an account yet.
model Party {
  id     String  @id @default(cuid())
  userId String
  name   String
  phone  String?
  note   String?
  // CUSTOMER — usually owes you | SUPPLIER — you usually owe them
  type   String  @default("CUSTOMER")

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries KhataEntry[]

  @@index([userId, isArchived])
}

model KhataEntry {
  id      String    @id @default(cuid())
  userId  String
  partyId String
  // GAVE — you gave money or goods on credit, so they owe you more
  // GOT  — you received a payment, so what they owe goes down
  type    String
  amount  BigInt
  date    DateTime
  note    String?
  // When this udhaar should be settled — drives the due list on the dashboard.
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([userId, partyId, date])
  @@index([partyId, date])
  @@index([userId, dueDate])
}

// Server-side sessions so a login can be revoked without rotating secrets.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id             String @id @default(cuid())
  userId         String
  name           String
  // BANK | CASH | CREDIT_CARD | WALLET | INVESTMENT | LOAN
  type           String
  // Integer paise. Current balance is derived: opening + inflows - outflows.
  openingBalance BigInt @default(0)
  currency       String @default("INR")

  creditLimit     BigInt?
  billingCycleDay Int?
  dueDay          Int?
  interestRate    Float?

  icon       String  @default("wallet")
  color      String  @default("#2563eb")
  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)
  // Excluded from "Safe to Spend" liquidity (investments, loans).
  isLiquid   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions      Transaction[]   @relation("AccountTransactions")
  incomingTransfers Transaction[]   @relation("TransferDestination")
  recurringRules    RecurringRule[] @relation("RecurringSource")
  recurringTargets  RecurringRule[] @relation("RecurringDestination")
  goals             Goal[]

  @@index([userId, isArchived])
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  // INCOME | EXPENSE
  kind   String
  // NEEDS | LIFESTYLE | SAVINGS | INVESTMENTS | EMERGENCY | INCOME
  bucket String @default("NEEDS")

  icon      String   @default("circle")
  color     String   @default("#64748b")
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name, kind])
  @@index([userId, kind])
}

model Transaction {
  id     String   @id @default(cuid())
  userId String
  // INCOME | EXPENSE | TRANSFER
  type   String
  // Always a positive integer in paise. Direction comes from `type`.
  amount BigInt
  date   DateTime

  note     String?
  merchant String?

  // EXPENSE/TRANSFER: money leaves `accountId`.
  // INCOME: money arrives in `accountId`.
  accountId   String
  // TRANSFER only: money arrives in `toAccountId`.
  toAccountId String?
  categoryId  String?

  // UPI | CARD | CASH | NETBANKING | AUTO_DEBIT | OTHER
  paymentMethod String  @default("UPI")
  referenceId   String?

  // Keeps one-off items (reimbursements, self-transfers) out of budget math.
  excludeFromBudget Boolean @default(false)

  recurringRuleId String?
  goalId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account        @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount     Account?       @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([recurringRuleId, date])
}

// Powers recurring transactions, the bill/subscription manager and the
// upcoming-outflow side of Safe to Spend.
model RecurringRule {
  id         String  @id @default(cuid())
  userId     String
  name       String
  // INCOME | EXPENSE | TRANSFER
  type       String
  amount     BigInt
  // Amount varies month to month (electricity, credit card bill).
  isVariable Boolean @default(false)

  accountId   String
  toAccountId String?
  categoryId  String?

  // DAILY | WEEKLY | MONTHLY | QUARTERLY | YEARLY
  frequency   String
  interval    Int    @default(1)
  dayOfMonth  Int?
  weekday     Int?
  monthOfYear Int?

  startDate    DateTime
  endDate      DateTime?
  nextDueDate  DateTime
  lastPostedAt DateTime?

  // true  -> auto-create the transaction when due
  // false -> only remind (bills the user pays manually)
  autoPost           Boolean @default(false)
  // Surfaces in the Bills & Subscriptions view.
  isBill             Boolean @default(true)
  reminderDaysBefore Int     @default(2)
  merchant           String?
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation("RecurringSource", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account?  @relation("RecurringDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId, isActive, nextDueDate])
}

model Budget {
  id         String  @id @default(cuid())
  userId     String
  categoryId String
  // "YYYY-MM" — avoids timezone drift on month boundaries.
  period     String
  amount     BigInt
  rollover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId, period])
}

// Phase 2 surface, modelled now because Safe to Spend subtracts planned savings.
model Goal {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  icon                String    @default("target")
  targetAmount        BigInt
  savedAmount         BigInt    @default(0)
  targetDate          DateTime?
  monthlyContribution BigInt    @default(0)
  accountId           String?
  priority            Int       @default(0)
  isArchived          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId, isArchived])
}
